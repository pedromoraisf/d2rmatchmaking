    },
    "acceptance.flaky": {
      "value": null,
      "direction": "lower",
      "ceiling": 0,
      "contexts": [
        "phase"
      ],
      "source": {
        "type": "json",
        "path": "reports/acceptance/results.json",
        "pointer": "/stats/flaky"
      }
    }
  }
}
