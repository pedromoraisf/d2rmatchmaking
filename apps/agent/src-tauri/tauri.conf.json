{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D2RMatchMaking",
  "version": "../package.json",
  "identifier": "com.d2rmm.agent",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "D2RMatchMaking Agent",
        "width": 420,
        "height": 320,
        "resizable": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/pedromoraisf/d2rmatchmaking/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMjJENDc4OTZDRThBRDIKUldUU2lzNldlTlFpd0RCVHU5cGV6eEY4MDMvaUVGWjRJWFdpdkE2ckxKU2EvZm4yREZtNDFVV2sK"
    }
  }
}
