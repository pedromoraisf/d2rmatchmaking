{
  "name": "@d2rmm/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier presets for every D2R Match Making workspace.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.dom.json": "./tsconfig.dom.json",
    "./eslint": "./eslint.mjs",
    "./prettier": "./prettier.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
