{
  "asyncapi": "3.0.0",
  "info": {
    "title": "D2R Match Making events",
    "version": "0.0.0"
  },
  "channels": {
    "stream": {
      "address": "/v1/stream",
      "messages": {
        "RoomAssigned": {
          "$ref": "#/components/messages/RoomAssigned"
        },
        "RoomStageChanged": {
          "$ref": "#/components/messages/RoomStageChanged"
        },
        "AgentPresenceChanged": {
          "$ref": "#/components/messages/AgentPresenceChanged"
        }
      }
    }
  },
  "operations": {
    "receiveStreamEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/stream"
      }
    }
  },
  "components": {
    "messages": {
      "RoomAssigned": {
        "name": "room.assigned",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "room.assigned"
            },
            "data": {
              "type": "object",
              "properties": {
                "roomId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "run": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "expectedGameName": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^mm[a-z]+-\\d+$"
                },
                "members": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "characterId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "joinOrder": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "host",
                          "member"
                        ]
                      }
                    },
                    "required": [
                      "accountId",
                      "characterId",
                      "joinOrder",
                      "role"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "roomId",
                "run",
                "expectedGameName",
                "members"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "RoomStageChanged": {
        "name": "room.stage_changed",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "room.stage_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "roomId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "formed",
                    "awaiting_host",
                    "created",
                    "active",
                    "closed",
                    "expired"
                  ]
                },
                "members": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "characterId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "joinOrder": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "host",
                          "member"
                        ]
                      }
                    },
                    "required": [
                      "accountId",
                      "characterId",
                      "joinOrder",
                      "role"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "roomId",
                "stage",
                "members"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "AgentPresenceChanged": {
        "name": "agent.presence_changed",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent.presence_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "agentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "online": {
                  "type": "boolean"
                },
                "gameRunning": {
                  "type": "boolean"
                },
                "screen": {
                  "type": "string",
                  "enum": [
                    "UNKNOWN",
                    "AUTOMAP_OPEN"
                  ]
                }
              },
              "required": [
                "agentId",
                "online",
                "gameRunning",
                "screen"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "data"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
