{
  "asyncapi": "3.0.0",
  "info": {
    "title": "D2R Match Making events",
    "version": "0.0.0"
  },
  "channels": {
    "stream": {
      "address": "/v1/stream",
      "messages": {
        "RoomAssigned": {
          "$ref": "#/components/messages/RoomAssigned"
        },
        "RoomStageChanged": {
          "$ref": "#/components/messages/RoomStageChanged"
        },
        "RoomRunOpened": {
          "$ref": "#/components/messages/RoomRunOpened"
        },
        "RoomMemberChanged": {
          "$ref": "#/components/messages/RoomMemberChanged"
        },
        "AgentPresenceChanged": {
          "$ref": "#/components/messages/AgentPresenceChanged"
        },
        "CharactersUpdated": {
          "$ref": "#/components/messages/CharactersUpdated"
        },
        "QueueUpdated": {
          "$ref": "#/components/messages/QueueUpdated"
        },
        "ReadyCheckStarted": {
          "$ref": "#/components/messages/ReadyCheckStarted"
        },
        "ReadyCheckUpdated": {
          "$ref": "#/components/messages/ReadyCheckUpdated"
        },
        "ReadyCheckResolved": {
          "$ref": "#/components/messages/ReadyCheckResolved"
        }
      }
    }
  },
  "operations": {
    "receiveStreamEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/stream"
      }
    }
  },
  "components": {
    "messages": {
      "RoomAssigned": {
        "name": "room.assigned",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "room.assigned"
            },
            "data": {
              "type": "object",
              "properties": {
                "roomId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "run": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "expectedGameName": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^mm[a-z]+-\\d+$"
                },
                "members": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "characterId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "joinOrder": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "host",
                          "member"
                        ]
                      },
                      "team": {
                        "type": "string",
                        "enum": [
                          "a",
                          "b"
                        ]
                      },
                      "confirmed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "accountId",
                      "characterId",
                      "joinOrder",
                      "role"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "roomId",
                "run",
                "expectedGameName",
                "members"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "data"
          ],
          "additionalProperties": false
        }
      },
