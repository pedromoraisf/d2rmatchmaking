{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "ready_check.started"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode": {
          "type": "string",
          "enum": [
            "pvp",
            "leveling"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "normal",
            "nightmare",
            "hell"
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "now": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "members": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "class": {
                "type": "string",
                "enum": [
                  "amazon",
                  "assassin",
                  "barbarian",
                  "druid",
                  "necromancer",
                  "paladin",
                  "sorceress",
                  "warlock"
                ]
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "accepted": {
                "type": "boolean"
              },
              "you": {
                "type": "boolean"
              }
            },
            "required": [
              "position",
              "class",
              "level",
              "accepted",
              "you"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "mode",
        "difficulty",
        "deadline",
        "now",
        "members"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "data"
  ],
  "additionalProperties": false
}
