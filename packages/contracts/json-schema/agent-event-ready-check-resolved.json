{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "ready_check.resolved"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "outcome": {
          "type": "string",
          "enum": [
            "accepted",
            "declined",
            "timed-out"
          ]
        }
      },
      "required": [
        "id",
        "outcome"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "data"
  ],
  "additionalProperties": false
}
