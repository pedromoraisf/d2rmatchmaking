{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "characters": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 15,
            "pattern": "^[A-Za-z]+(?:[-_][A-Za-z]+)?$"
          },
          "class": {
            "type": "string",
            "enum": [
              "amazon",
              "assassin",
              "barbarian",
              "druid",
              "necromancer",
              "paladin",
              "sorceress",
              "warlock"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "hardcore": {
            "type": "boolean"
          },
          "unlockedDifficulties": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "nightmare",
                "hell"
              ]
            }
          }
        },
        "required": [
          "name",
          "class",
          "level",
          "hardcore",
          "unlockedDifficulties"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "characters"
  ],
  "additionalProperties": false
}
