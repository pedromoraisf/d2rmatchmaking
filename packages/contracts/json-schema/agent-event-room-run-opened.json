{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "room.run_opened"
    },
    "data": {
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedGameName": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^mm[a-z]+-\\d+$"
        },
        "members": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "characterId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "joinOrder": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "role": {
                "type": "string",
                "enum": [
                  "host",
                  "member"
                ]
              },
              "team": {
                "type": "string",
                "enum": [
                  "a",
                  "b"
                ]
              },
              "confirmed": {
                "type": "boolean"
              }
            },
            "required": [
              "accountId",
              "characterId",
              "joinOrder",
              "role"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "roomId",
        "run",
        "expectedGameName",
        "members"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "data"
  ],
  "additionalProperties": false
}
