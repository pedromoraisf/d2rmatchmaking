{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Neon/Postgres connection string with password",
            "pattern": "/postgres(?:ql)?:\\/\\/[^:\\s/]+:[^@\\s]+@[^\\/\\s]*neon\\.tech/"
          },
          {
            "name": "Tauri updater private key",
            "pattern": "/untrusted comment: (?:rsign|minisign) encrypted secret key/"
          },
          {
            "name": "Render deploy hook URL",
            "pattern": "/https:\\/\\/api\\.render\\.com\\/deploy\\/srv-[A-Za-z0-9]+\\?key=[A-Za-z0-9_-]+/"
          },
          {
            "name": "Grafana Cloud / OTLP basic auth header",
            "pattern": "/Authorization=Basic%20[A-Za-z0-9+/=]{20,}/"
          }
        ]
      }
    }
  ]
}
