{
  "name": "d2r-match-making",
  "private": true,
  "version": "0.0.0",
  "description": "Community matchmaking for Diablo II: Resurrected — PvP and leveling queues, live rooms, ranking, and a read-only desktop agent.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "eslint --max-warnings 0 scripts .claude/hooks eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm run test:harness && turbo run test",
    "test:harness": "node --test \"scripts/**/*.test.mjs\" \".claude/hooks/**/*.test.mjs\"",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:mutation": "turbo run test:mutation",
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages tests",
    "contracts:openapi": "turbo run contracts:openapi",
    "contracts:check": "turbo run contracts:openapi && git diff --exit-code -- packages/contracts/openapi.json packages/contracts/asyncapi.json",
    "harness": "harness-score . --config .harness-score.json",
    "harness:gate": "harness-score . --config .harness-score.json --min-level 4 --quiet",
    "harness:json": "harness-score . --config .harness-score.json --json --quiet > .harness-score.report.json",
    "quality:collect": "node scripts/quality-collect.mjs",
    "quality:ratchet": "node scripts/quality-ratchet.mjs",
    "specs:check": "node scripts/specs-check.mjs && node scripts/acceptance-check.mjs",
    "tlc:selftest": "python3 .claude/skills/tlc-spec-driven/scripts/selftest.py",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run arch && pnpm run test && pnpm run specs:check && pnpm run harness:gate && pnpm run quality:gate",
    "attempt": "node scripts/attempt.mjs",
    "attempt:report": "node scripts/attempt.mjs report",
    "test:acceptance": "turbo run test:acceptance",
    "acceptance:check": "node scripts/acceptance-check.mjs",
    "phase:status": "node scripts/phase-status.mjs",
    "quality:gate": "pnpm run harness:json && node scripts/quality-collect.mjs && node scripts/quality-ratchet.mjs --context pr --current reports/quality.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@secretlint/secretlint-rule-pattern": "^10.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^10.0.0",
    "dependency-cruiser": "^17.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "harness-score": "^1.8.3",
    "lefthook": "^2.0.0",
    "prettier": "^3.6.2",
    "secretlint": "^10.0.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
